generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OperatorStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  AVAILABLE
  ASSIGNED
  SUSPENDED
  INACTIVE
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model LogisticOperator {
  id            String         @id @default(uuid()) @db.Uuid
  clerk_user_id String         @unique
  status        OperatorStatus @default(ACTIVE)
  shipments    Shipment[]
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
}

model Driver {
  id            String       @id @default(uuid()) @db.Uuid
  clerk_user_id String       @unique
  status        DriverStatus @default(AVAILABLE)
  shipments    Shipment[]
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
}

model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  tracking_id       String         @unique
  order_id          String
  buyer_id          String
  seller_id         String
  status           ShipmentStatus @default(PENDING)
  delivery_address String         @db.Text
  delivered_at     DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  operator_id       String?        @db.Uuid
  operator         LogisticOperator? @relation(fields: [operator_id], references: [id])

  driver_id         String?        @db.Uuid
  driver           Driver?        @relation(fields: [driver_id], references: [id])

  tracking_events  TrackingEvent[]
}

model TrackingEvent {
  id          String   @id @default(uuid()) @db.Uuid
  shipment_id String   @db.Uuid
  shipment   Shipment @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  status     String
  timestamp  DateTime @default(now())
}